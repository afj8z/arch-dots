# Zathura configuration file
# See man `man zathurarc'


# One page per row by default
set pages-per-row 1

#stop at page boundries
set scroll-page-aware "true"
set scroll-full-overlap 0.01
set scroll-step 0.01

# maps
map r reload
map p print
map i recolor
map J zoom out
map K zoom in
map R rotate


#zoom settings
set zoom-min 10
set guioptions "c"

# zathurarc-dark
set font "Lilex Nerd Font Mono 19"
set default-bg "#111012" #00
set default-fg "#DBD0C6" #01

set statusbar-fg "#DBD0C6" #04
set statusbar-bg "#25212B" #01

set inputbar-bg "#25212B" #00 currently not used
set inputbar-fg "#DBD0C6" #02

set notification-error-bg "#99453D" #08
set notification-error-fg "#111012" #00

set notification-warning-bg "#99453D" #08
set notification-warning-fg "#111012" #00

set highlight-color "#8A7FA3" #0A
set highlight-active-color "#b4d4cf" #0D

set completion-highlight-fg "#111012" #02
set completion-highlight-bg "#00BCD4B3" #0C

set completion-bg "#30303003" #02
set completion-fg "#FFC107C4" #0C

set notification-bg "#8A7FA3" #0B
set notification-fg "#111012" #00

set recolor "true"
set recolor-lightcolor "#111012" #00
set recolor-darkcolor "#DBD0C6" #06
set recolor-reverse-video "true"
set recolor-keephue "true"

set selection-clipboard clipboard
set render-loading "false"
set scroll-step 50
