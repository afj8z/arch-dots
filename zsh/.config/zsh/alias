# vim: ft=zsh
typeset -A _core_aliases _git_aliases _app_aliases _script_paths

_core_aliases=(
    q       'exit'
    zrl     'source $ZDOTDIR/.zshrc'
    ll      'ls -a --color=auto'
    la      'ls -lha --color=auto --group-directories-first'
    grep    'grep --color=auto'
    fk      "sudo !!"
    rm      "rm -Iv"
    rmrf    "rm -Ivrf"
    mv      "mv -i"
    md      "mkdir -p"
    df      "df -h" 
    du      "du -h -d 1" 
	cat		"bat"
	_cat	"cat"
	ztime   "time ZSH_DEBUGRC=1 zsh -i -c exit"
	fixcomp 'rm -f "$_comp_dump"; compinit -d "$_comp_dump"; zcompile "$_comp_dump"; echo "Completion cache rebuilt."'
)

_git_aliases=(
    g       "git"
	ga 		"git add"
	gb 		"git branch"
	gm 		"git merge"
	gpu 	"git push"
	gch 	"git checkout"
    gs      "git status"
    gpl     "git pull"
	gcm		"git commit -m"
)

_app_aliases=(
    zv      "nvim $ZDOTDIR/.zshrc"
    vi      'nvim'
    v       'nvim'
    ve      'nvim -c Oil'
    y       "yazi"
    gg      "bg kys"
    glry    'feh -g 640x480 -d --scale-down -S filename'
    fz      'fzf  --preview "bat --style=numbers --color=always {}" --preview-window "~3"'
    freem   "free -h | bat -l cpuinfo -p"
    poet    '$(poetry env activate)' 
	comp    'make clean && bear -- make all'
)

_script_paths=(
	vpn "$HOME/.local/scripts/util/vpn-login.sh"
)

# "${(@kv)VAR}" expands key, value of array
for key val in "${(@kv)_core_aliases}" "${(@kv)_git_aliases}" "${(@kv)_app_aliases}" "${(@kv)_script_paths}"; do
    alias "$key=$val"
done

# cleanup
unset _core_aliases _git_aliases _app_aliases key val
