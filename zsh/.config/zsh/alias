# seperate
typeset -A _core_aliases _git_aliases _app_aliases

_core_aliases=(
    q       'exit'
    zrl     'source $ZDOTDIR/.zshrc'
    ll      'ls -a --color=auto'
    la      'ls -lha --color=auto --group-directories-first'
    grep    'grep --color=auto'
    fk      "sudo !!"
    rm      "rm -Iv"
    rmrf    "rm -Ivrf"
    mv      "mv -i"
    md      "mkdir -p"
    df      "df -h" 
    du      "du -h -d 1" 
)

_git_aliases=(
    g       "git"
	ga 		"git add"
    gs      "git status"
    gpl     "git pull"
)

_app_aliases=(
    zv      "nvim $ZDOTDIR/.zshrc"
    vi      'nvim'
    v       'nvim'
    ve      'nvim .'
    y       "yazi"
    gg      "bg kys"
    glry    'feh -g 640x480 -d --scale-down -S filename'
    fz      'fzf  --preview "bat --color=always {}" --preview-window "~3"'
    freem   "free -h | bat -l cpuinfo -p"
    poet    '$(poetry env activate)' 
)

# "${(@kv)VAR}" expands the Key and Value of the array.
for key val in "${(@kv)_core_aliases}" "${(@kv)_git_aliases}" "${(@kv)_app_aliases}"; do
    alias "$key=$val"
done

# Cleanup
unset _core_aliases _git_aliases _app_aliases key val
