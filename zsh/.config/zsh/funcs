# Function to toggle back to the last background process
fancy-ctrl-z() {
  if [[ $#BUFFER -eq 0 ]]; then
    local jobs_count=$(jobs | wc -l)
    if [[ $jobs_count -eq 1 ]]; then
      BUFFER="fg"
      zle accept-line
    else
      echo jobs
      BUFFER="fg"
      zle accept-line
    fi
  else
    zle push-input
    zle clear-screen
  fi
}


# Bindings
zle -N finder
bindkey '^e' finder

zle -N fancy-ctrl-z
bindkey '^Z' fancy-ctrl-z
