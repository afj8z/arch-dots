cpc() {
    local smart_exclude=true
    local excludes=()
    local open_nvim=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --no-smart)
                smart_exclude=false
                shift
                ;;
            -e|--exclude)
                excludes+=("-i" "$2")
                shift 2
                ;;
            v|vi|nvim|vim)
                open_nvim=true
                shift
                ;;
            *)
                shift
                ;;
        esac
    done

    if [[ "$smart_exclude" == true ]]; then
        while IFS= read -r xml_file; do
            local dir="${xml_file%/*}"
            local base=$(basename "$xml_file" .xml)
            
            for file in "$dir"/"$base"*.{c,h}; do
                if [[ -f "$file" ]]; then
                    excludes+=("-i" "$file")
                fi
            done
        done < <(find . -type f -name "*.xml" 2>/dev/null)
    fi

    cppcheck --project=compile_commands.json \
        "${excludes[@]}" \
        --enable=all --suppress=missingIncludeSystem \
        --inline-suppr \
		--suppressions-list=cppcheck_suppress.txt \
        --check-level=exhaustive \
        --template=gcc 2>&1 | tee cppcheck.log

    if [[ "$open_nvim" == true ]]; then
        nvim -q cppcheck.log
    fi
}

