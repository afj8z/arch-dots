#!/bin/env bash

random_quote=$(random_quote.sh)

anims=(
	"slide --merge"
	"slide"
	"rain"
	"binarypath"
	"bouncyballs"
	"bubbles"
	)

selectedanim=${anims[ $RANDOM % ${#anims[@]} ]}

if [ -n "$random_quote" ]; then
    IFS='|' read -r quote author <<< "$random_quote"

    mapfile -t quote_lines < <(echo "$quote" | fmt -w 50)
    
    author_line="— $author"

    max_width=0
    for line in "${quote_lines[@]}"; do
        (( ${#line} > max_width )) && max_width=${#line}
    done
    
    (( ${#author_line} > max_width )) && max_width=${#author_line}

    art_output=$({
        printf '╭%*s╮\n' "$((max_width + 2))" '' | tr ' ' '-'

        for line in "${quote_lines[@]}"; do
            printf "│ %-*s │\n" "$max_width" "$line"
        done

        printf '│%*s│\n' "$((max_width + 2))" ''

        printf "│ %*s │\n" "$((max_width + 2))" "$author_line"

        printf '╰%*s╯\n' "$((max_width + 2))" '' | tr ' ' '-'
        
        echo "      \ "
        echo "       \ "
        echo "         .--. "
        echo "        |o_o |"
        echo "        |:_/ |"
        echo "       //    \ \\ "
        echo "      (|      | )"
        echo "     /'\\_  _/\`\\ "
        echo "     \\___)=(___/ "
    })
    # --- Pipe the captured output to tte for animation ---
    echo "$art_output" | tte  --frame-rate 480 "$selectedanim"
fi
