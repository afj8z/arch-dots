sort=-time
layer=overlay
width=300
height=110
border-size=2
border-radius=0
icons=0
max-icon-size=64
default-timeout=5000
ignore-timeout=1

background-color=#DBD6BD
border-color=#1A1A1A
font={{ name.font_family }} {{ name.font_size }}

[urgency=low]
