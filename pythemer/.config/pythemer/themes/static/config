sort=-time
layer=overlay
width=300
height=110
border-size=2
border-radius=0
icons=0
max-icon-size=64
default-timeout=5000
ignore-timeout=1

background-color=#383D3F
border-color=#CED4D4
font={{ name.font_family }} {{ name.font_size }}

[urgency=low]
border-color=#5D6569

[urgency=normal]
border-color=#8DA3A3

[urgency=high]
border-color=#A88A8A
default-timeout=0

[category=mpd]
default-timeout=2000
group-by=category
