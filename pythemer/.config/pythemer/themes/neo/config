on-notify=exec notify-bar "$id"
sort=-time
layer=overlay
width=300
height=110
border-size=2
border-radius=0
icons=0
max-icon-size=64
default-timeout=5000
ignore-timeout=1

background-color=#C5B88A
border-color=#2b2b2b
font= monospace 14

[urgency=low]
border-color=#666666

[urgency=normal]
border-color=#7e9cd8

[urgency=high]
border-color=#c8405a
default-timeout=0

[category=mpd]
default-timeout=2000
group-by=category
