sort=-time
layer=overlay
width=300
height=110
border-size=2
border-radius=0
icons=0
max-icon-size=64
default-timeout=5000
ignore-timeout=1

background-color=#353A3A
border-color=#BDBBB0
font={{ name.font_family }} {{ name.font_size }}

[urgency=low]
border-color=#626B6B

[urgency=normal]
border-color=#8A918A

[urgency=high]
border-color=#D18282
default-timeout=0

[category=mpd]
default-timeout=2000
group-by=category
