sort=-time
layer=overlay
width=300
height=110
border-size=2
border-radius=0
icons=0
max-icon-size=64
default-timeout=5000
ignore-timeout=1

background-color=#2A2F38
border-color=#D7D7C8
font={{ name.font_family }} {{ name.font_size }}

[urgency=low]
border-color=#5C667A

[urgency=normal]
border-color=#8999A8

[urgency=high]
border-color=#C47575
default-timeout=0

[category=mpd]
default-timeout=2000
group-by=category
