on-notify=exec notify-bar "$id"
sort=-time
layer=overlay
width=300
height=110
border-size=2
border-radius=0
icons=0
max-icon-size=64
default-timeout=5000
ignore-timeout=1

background-color=#a8a6a7
border-color=#242324
font= monospace 14

[urgency=low]
border-color=#575657

[urgency=normal]
border-color=#9a7895

[urgency=high]
border-color=#b85c63
default-timeout=0

[category=mpd]
default-timeout=2000
group-by=category
