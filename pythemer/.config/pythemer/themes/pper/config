on-notify=exec notify-bar "$id"
sort=-time
layer=overlay
width=300
height=110
border-size=2
border-radius=0
icons=0
max-icon-size=64
default-timeout=5000
ignore-timeout=1

background-color=#E0DEF4
border-color=#E0DEF4
font= monospace 14

[urgency=low]
border-color=#907AA9

[urgency=normal]
border-color=#907AA9

[urgency=high]
border-color=#B4637A
default-timeout=0

[category=mpd]
default-timeout=2000
group-by=category
