set default-bg {{ background | shade.01 @rgb @transparent(0.8) }}
set default-fg "{{ foreground || shade.07 }}"

set statusbar-fg "{{ foreground || shade.07 }}"
set statusbar-bg "{{ shade.03 }}"

set inputbar-bg "{{ shade.03 }}"
set inputbar-fg "{{ foreground || shade.07 }}"

set notification-error-bg "{{ color9 }}"
set notification-error-fg "{{ background | shade.01 }}"

set notification-warning-bg "{{ color3 }}"
set notification-warning-fg "{{ background | shade.01 }}"

set highlight-color "{{ background @lighten(0.15) @saturate(0.1) }}"
set highlight-active-color "{{ accent }}"

set completion-highlight-fg "{{ background | shade.01 }}"
set completion-highlight-bg "{{ accent }}"

set completion-bg "{{ shade.03 }}"
set completion-fg "{{ foreground || shade.07 }}"

set recolor "true"
set recolor-lightcolor "{{ background | shade.01 }}"
set recolor-darkcolor "{{ foreground || shade.07 }}"
