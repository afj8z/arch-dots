sort=-time
layer=overlay
width=300
height=110
border-size=2
border-radius=0
icons=0
max-icon-size=64
default-timeout=5000
ignore-timeout=1

background-color=#3D3A37
border-color=#D6D1CB
font={{ name.font_family }} {{ name.font_size }}

[urgency=low]
border-color=#66615C

[urgency=normal]
border-color=#A39E8B

[urgency=high]
border-color=#B38585
default-timeout=0

[category=mpd]
default-timeout=2000
group-by=category
