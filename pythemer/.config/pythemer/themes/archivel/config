on-notify=exec notify-bar "$id"
sort=-time
layer=overlay
width=300
height=110
border-size=2
border-radius=0
icons=0
max-icon-size=64
default-timeout=5000
ignore-timeout=1

background-color=#DFDBC3
border-color=#1A1A1A
font= monospace 14

[urgency=low]
border-color=#8C8870

[urgency=normal]
border-color=#2D4F67

[urgency=high]
border-color=#B33D41
default-timeout=0

[category=mpd]
default-timeout=2000
group-by=category
