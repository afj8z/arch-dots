on-notify=exec notify-bar "$id"
sort=-time
layer=overlay
width=300
height=110
border-size=2
border-radius=0
icons=0
max-icon-size=64
default-timeout=5000
ignore-timeout=1

background-color=#322d32
border-color=#d9d4d0
font= monospace 14

[urgency=low]
border-color=#8e7f72

[urgency=normal]
border-color=#b492af

[urgency=high]
border-color=#d3868c
default-timeout=0

[category=mpd]
default-timeout=2000
group-by=category
