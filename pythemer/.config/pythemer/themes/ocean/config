on-notify=exec notify-bar "$id"
sort=-time
layer=overlay
width=300
height=110
border-size=2
border-radius=0
icons=0
max-icon-size=64
default-timeout=5000
ignore-timeout=1

background-color=#374550
border-color=#c0c8d0
font= monospace 14

[urgency=low]
border-color=#7b8a97

[urgency=normal]
border-color=#458588

[urgency=high]
border-color=#cc6666
default-timeout=0

[category=mpd]
default-timeout=2000
group-by=category
