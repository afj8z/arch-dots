{
  "default_template_dir": "${XDG_CONFIG_HOME}/pythemer/templates",
  "install_mapping": {
    "ffroot.css": "~/.mozilla/firefox/0u42zzwn.default-release-1782564747730/chrome/root.css",
    "fftheme.css": [
      "~/.mozilla/firefox/0u42zzwn.default-release-1782564747730/chrome/theme/fftheme.css",
      "~/.mozilla/firefox/fplt1o53.previewer/chrome/theme/fftheme.css"
    ],
    "colors.lua": "${XDG_CONFIG_HOME}/nvim/lua/ajf/colors.lua",
    "customss.lua": "~/dev/jome.nvim/lua/nvim-tundra/stylesheet/custom.lua",
    "custom.lua": "~/dev/jome.nvim/lua/nvim-tundra/palette/custom.lua",
    "kitty-colors.conf": "${XDG_CONFIG_HOME}/kitty/kitty-theme.conf",
    "shell-theme.sh": "${XDG_CONFIG_HOME}/zsh/shell-theme.sh",
    "config": "${XDG_CONFIG_HOME}/mako/config",
    "zathuratheme": "${XDG_CONFIG_HOME}/zathura/zathuratheme",
    "tmux-theme.conf": "${XDG_CONFIG_HOME}/tmux/tmux-theme.conf",
    "theme.typ": "~/lib/typst/local/test/0.1.0/__theme.typ",
    "foottheme.ini": "${XDG_CONFIG_HOME}/foot/foottheme.ini",
    "sioyek_theme": "${XDG_CONFIG_HOME}/sioyek/sioyek_theme",
    "dwlbar.sh": "~/.local/bin/reload-dwlb.sh",
    "wlcolors": "~/.wlcolors",
    "typst-theme": "~/lib/typst/local/util/0.1.0/lib/theme/system_theme.typ",
    "gowall.json": "~/.config/gowall/gowall.json",
    "themesh": "~/.config/themesh/shtheme.conf",
    "gtktheme": "/tmp/gtktheme"
  },
  "reload_commands": [
    ["killall", "-SIGUSR2", "mako"],
    ["pkill", "-SIGUSR1", "kitty"],
    ["tmux", "source", "~/.tmux.conf"],
    ["touch", "~/.config/sioyek/prefs_user.config"],
    ["dwlctl", "reload-colors"],
    ["spicetify", "apply"],
    ["someblocks", "-s /tmp/mybar", "-c"],
    ["somebar", "-s", "/tmp/mybar", "-c", "reload"],
    [
      "gowall",
      "convert",
      "~/pictures/wallpapers/myjo.png",
      "-t",
      "~/.config/gowall/gowall.json",
      "--output",
      "${WALLPAPER}"
    ],
    ["theme.sh", "--add", "~/.config/themesh/shtheme.conf"],
    ["theme.sh", "shtheme"],
    ["bash", "/tmp/gtktheme"]
  ]
}
