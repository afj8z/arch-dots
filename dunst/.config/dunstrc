[global]
    monitor = 0
    follow = none
    width = (100, 400)
    height = (0, 300)
    origin = top-center
    offset = (0, 25)
    scale = 0
    notification_limit = 20

    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 1
    progress_bar_min_width = 200
    progress_bar_max_width = 250
    progress_bar_corner_radius = 10
    progress_bar_corners = all

    icon_corner_radius = 0
    icon_corners = all

    indicate_hidden = yes
    transparency = 0
    separator_height = 2
    padding = 8
    horizontal_padding = 8
    text_icon_padding = 0
    frame_width = 2
    frame_color = "#a7bd97"     # accent frame (was #C58EA7)
    gap_size = 0
    separator_color = frame

    sort = yes
    font = FiraCode Nerd Font Mono 12
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    enable_recursive_icon_lookup = true
    icon_position = off
    sticky_history = yes
    history_length = 20

    dmenu = /usr/bin/dmenu -p dunst:
    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst

    corner_radius = 4
    corners = all
    force_xwayland = false

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#262424e6"
    foreground = "#a6a69c"
    frame_color = "#a7bd97"
    timeout = 10

[urgency_normal]
    background = "#262424e6"
    foreground = "#cfcbbe"
    frame_color = "#a7bd97"
    timeout = 10

[urgency_critical]
    background = "#262424e6"
    foreground = "#c4746e"
    frame_color = "#a7bd97"
    timeout = 0

[media-base]
    appname = notify-media
    history_ignore = yes
    format = "%s"
    timeout = 1500

[media-volume]
    appname = notify-media
    stack_tag = audio
    background = "#262424e6"
    foreground = "#cfcbbe"
    frame_color = "#a7bd97"
    urgency = normal

[media-brightness]
    appname = notify-media
    stack_tag = brightness
    background = "#262424e6"
    foreground = "#cfcbbe"
    frame_color = "#a7bd97"
    urgency = low

[media-mic]
    appname = notify-media
    stack_tag = mic
    background = "#262424e6"
    foreground = "#c4746e"
    frame_color = "#a7bd97"
    urgency = normal
