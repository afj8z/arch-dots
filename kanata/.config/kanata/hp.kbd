(defcfg
  danger-enable-cmd yes
  concurrent-tap-hold yes
  process-unmapped-keys yes
  block-unmapped-keys yes
  delegate-to-first-layer yes
  log-layer-changes no
  ;; tap-hold-require-prior-idle 10
  allow-hardware-repeat false)

(include src-laptop.kbd)

(include helpers.kbd)


(defalias 
	safecr 			(tap-hold $tap $safe XX lrld)
  	safecy 			(tap-hold $tap $safe (macro n o p e) (t! withmsg "'Kanata keyboard switched from hp'" lrld-next))
	to-norden       (tap-hold $tap $safe XX (t! withmsg "'Active layer: Norden KB'" (layer-switch norden)))
	to-qwerty       (tap-hold $tap $safe XX (t! withmsg "'Active layer: Qwerty KB'" (layer-switch base-layer)))
	sym             (layer-while-held sym) 
	num             (layer-while-held num)
	esc             (tap-hold-release $tap $safe esc lctl)
	eq              (tap-hold-opposite-hand-release $hold = @num (timeout hold) (neutral-keys spc tab esc ret) (neutral tap))
	tr              (tap-hold-opposite-hand-release $hold 3 @sym (timeout hold) (neutral-keys spc tab esc ret) (neutral tap))
	tmx             (macro f24 C-s)
	met             (tap-hold-press $tap $safe met (chord wonk met))
up     (chord wonk up) 
down     (chord wonk down)
lft     (chord wonk lft) 
rght     (chord wonk rght)
)

(defchords wonk 4000
(met ) met
(up ) down
(down ) up
(rght ) rght
(lft ) lft
(met  up) @wonk-trans-max
(met  down) @wonk-trans-min
(met  lft) @wonk-toggle
(met  rght) @wonk-cfg
)

(defalias 
	(t! ons-hold lsft)
	(t! or-mod z lctl)
	(t! or-mod s lsft)
	(t! or-mod . lctl)
	(t! or-mod a lsft)
	(t! or-mod S-; lsft)
	(t! or-mod x lmet)
	(t! or-mod , lmet)
	;; NORDEN
	(t! or-mod x lctl)
	(t! or-mod r lsft)
	(t! or-mod v lmet)
)

(defalias 
spc				(tap-hold-release $tap $safe spc (layer-while-held num))
mag2 (switch
   ((key-history spc 1))  (multi (one-shot 1500 lsft) f22) break
   () (macro rpt f22) break
   )

rpt             (tap-hold-release $tap $safe @mag2 (layer-while-held sym))
)

(deflayer base-layer

	tab  q                 w        e        r        t                  y        u        i        o                p          

	esc    @a-lsft   s        d        f        g                           h        j        k        l  @S-;-lsft bspc

	@tmx      @z-lctl     @x-lmet  c        v        b                        n        m        @,-lmet  @.-lctl   ret

	@safecr                                  @spc       lsft              @met   @rpt                          @safecy

	@to-norden                      

	@up @down @lft @rght
)


(include norden-emod.kbd)
;; (deflayer norden
;;
;; 	tab  q                 l        d        b        z                  y        p        o        u             bspc
;;
;; 	ec    @r-lsft   n        t        h        f                           w        c        e        i   @a-lsft S-;
;;
;; 	@tmx      @x-lctl     j      m        k        v                            @mag     g       @,-lmet  @.-lctl  ret
;;
;; 	@safecr                                  s       @rpt              lsft    @spc                         @safecy
;;
;; 	@to-qwerty
;;
;; 	up down lft rght
;; )


(deflayer num

    tab  XX          XX    ,     .     XX          @%   7      8     9             bspc

    esc    -     @num  @+    =     XX                @*    1     2      @tr    /     ;

    @tmx   XX  lmet    XX   XX   XX                      @@    4     5     6        ret

	@safecr                 @spc       lsft      @rpt    0                      @safecy

	@to-qwerty                      

	up down lft rght
)


(deflayer sym
    tab  grv         @+    @^    @&    \           XX   [      ]     @|         bspc

    esc    /     @eq   @_    @*    @$                @!    @obr  @cbr  S-'   @#    ;

    @tmx   @~   -   @<   @>    @%                      @@    {     }     @?       ret

	@safecr                 @spc        lsft        @rpt      @_              @safecy

	@to-qwerty                      

	up down lft rght
)

(defalias
spc_sft (multi (tap-hold-release 0 170 XX lsft) spc)
)
