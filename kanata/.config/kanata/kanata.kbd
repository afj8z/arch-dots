(defcfg
  danger-enable-cmd yes
  concurrent-tap-hold yes
  process-unmapped-keys yes
  delegate-to-first-layer yes
  log-layer-changes no
  allow-hardware-repeat false
  rapid-event-delay 0
  chords-v2-min-idle 150
  )

;; REQUIRED: Keys must be in defsrc for advanced switch logic to track them

(defsrc)

(defvar
  tap-higher                                                                              400
  tap                                                                                	  200
  hold-time                                                                               200
  combo																					  30
  subl-time                                                                               200
  tmux-delay                                                                              40
  leader	;

  )


(defvirtualkeys
  
  sendp (macro p)
  
  relnop6 (release-key nop6))


;; linux tap-hold workaround
(deftemplate fix (action)
  (multi nop6 $action (macro 5 (on-press tap-vkey relnop6))))

;; The new Active Output State Machine

(deftemplate bi-layer-key (key my-nop other-nop target-layer)
  (switch
  ;; 1. On press: If the other key is ALREADY held (outputting its nop), switch instantly
  ($other-nop) (layer-while-held $target-layer) break
  
  ;; 2. Otherwise, start tap-hold waiting state
  () (t! fix (tap-hold 0 200 $key
  (switch
  ;; 3. On hold: Did the other key activate while we were waiting?
  ($other-nop) (layer-while-held $target-layer) break
  
  ;; 4. Otherwise: Output my NOP directly so the other key can read it
  () $my-nop break))) break))


(deftemplate crd (key trigger)
$key (switch ((input real $trigger)) (chord crd $key) break () $key break)  
)

(defoverridesv2
(nop2) (lsft 9) () (shifted)
(nop3) (lsft 0) () (shifted)

(nop2) (lsft ,) () (base-layer)
(nop3) (lsft .) () (base-layer)

;; (lsft .) (lsft ;) () ()
;; (lsft ,) (;) () () 
)


(deflayermap base-layer
  esc caps
  caps esc
  lalt (multi (layer-while-held shifted) lsft)
  lsft lctl
  rsft (multi (cmd bash -c "notify-send -u normal -t 5000 'LAYOUT SWITCHED TO ERGO'") (lrld-num 2))
  lctl lalt
  lmet (multi (layer-while-held super) lmet)
  ; S-;
  ;; ; (macro (sequence 1000 visible-backspaced) ; )
)

