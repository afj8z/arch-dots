if [ -f "$HOME/.config/zsh/shell-theme.sh" ]; then
    . "$HOME/.config/zsh/shell-theme.sh"
else
	echo "Theme file $HOME/.config/zsh/shell-theme.sh not found."
fi

# "$(awk '/wallpaper/ {sub(/^~/, ENVIRON["HOME"], $3); print $3}' ~/.wlcolors)"
export WALLPAPER="$HOME/pictures/wallpapers/wallpaper.png"

export GDK_SCALE=1.5
export QT_QPA_PLATFORM=wayland
export QT_STYLE_OVERRIDE=kvantum
export SDL_VIDEODRIVER=wayland
export MOZ_ENABLE_WAYLAND=1
export ELECTRON_OZONE_PLATFORM_HINT=wayland
export OZONE_PLATFORM=wayland

export XDG_CURRENT_DESKTOP=wlroots
export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=wlroots
export BEMENU_OPTS="--tb '$COLOR_ACCENT'\
 --tf '$COLOR_FG'\
 --fb '$COLOR_BG'\
 --ff '$COLOR_FG'\
 --nb '$COLOR_BG'\
 --nf '$COLOR_ACCENT'\
 --hb '$COLOR_ACCENT'\
 --hf '$COLOR_FG'\
 --sb '$COLOR_ACCENT'\
 --sf '$COLOR_FG'\
 --scb '$COLOR_BG'\
 --scf '$COLOR_ACCENT'\
 --bdr '$COLOR_ACCENT'\
 --fn 'FiraMono Nerd Font Mono 18'\
 -i --hp 5\
 -B 1"
