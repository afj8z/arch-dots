#invisible=1
	
on-notify=exec notify-bar "$id"


sort=-time
layer=overlay
width=300
height=110
border-size=2
border-radius=0
icons=0
max-icon-size=64
default-timeout=5000
ignore-timeout=1
font= monospace 14

background-color=#33373B
border-color=#DEDCD3

[urgency=low]
border-color=#616059

[urgency=normal]
border-color=#6A779C

[urgency=high]
border-color=#C46767
default-timeout=0

[category=mpd]
default-timeout=2000
group-by=category
