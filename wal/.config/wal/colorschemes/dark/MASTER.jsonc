{
	"primary": {
		"background": "#242422", // background main window
		"foreground": "#EDEDDA", // cursor, text
		"backgroundtrans": "rgba(36, 36, 34, 0.96)", // transparent bakground
		"mysurfacedim": "#302e2c", // unfocused, inactive window (statusline)
		"mysurfaceacc": "#383836", // focused, inactive window (statusline)
		"mytextdim": "#383836", // ghost text in main window
		"focusfloat": "#4e4e4a", // temp-floats, unfocused float
		"mytextmid": "#5E5E5A", // comments
		"punctuation": "#CCCCC0", // non-special punctuation 
		"mytextacc": "#EDE3CA", // slightly accented text
		"perm_button": "#EBCB8B", // active, unfocused, but variable button (current active line number) | A secondary accent, warning
		"selection": "#446063", // active text in selection
		"highlighted": "#383836", // inactive area in an active range (cursorline, text between matching brackets)
		"selected": "#98c379", // text that has been selected (yanked), cursor on button, active button (active tab)| A primary accent
	},
	"syntax": {
		"term_color0": "#302e2c", // darkest non-background color
		"keyword": "#BF616A", // keywords, return, except
		"string": "#A3BE8C", // string
		"function": "#83A4A6", // functions
		"conditional": "#B48EAD", // conditional, repeat
		"info": "#88C0D0", // builtin func, info
		"comments": "#5E5E5A", // comments
		"escape": "#e06c75", // errors, escape
		"modules": "#d19a66", // builtin vars, namespace, module
		"numbers": "#D18498", // Numbers, Boolean
		"fields": "#81A1C1", // fields
		"constants": "#ebdbb2" // Constants
	}
}


local c = {
    -- Base
    bg       = "#111012", -- Background
    fg       = "#DBD0C6", -- Foreground (Text, Identifiers, Punctuation)
    grey     = "#756D85", -- Comment, @comment

    -- Errors & Warnings
    red      = "#E46876", -- Error, @error, @text.danger
    yellow   = "#F7B982", -- Todo (bg), Warning, @text.warning, @text.todo

    -- Literals (Data)
    green    = "#98BB6C", -- String, @string
    lime     = "#A6E3A1", -- Regex, Escapes, @string.regex, @string.escape
    cyan     = "#89DCEB", -- Number, Float, @number, @float, @text.math
    orange   = "#F9929B", -- Boolean, @boolean
    pink     = "#F5C2E7", -- Constant, Builtin Var, @constant, @variable.builtin, @const.builtin

    -- Functions & Methods
    blue     = "#8AADF4", -- Function, Method, @function, @method
    sapphire = "#7DC4E4", -- Constructor, @constructor (Special function)

    -- Keywords & Control Flow
    purple   = "#C6A0F6", -- Keyword, Conditional, Repeat, @keyword, @repeat
    maroon   = "#EBA0AC", -- Exception, Return, @exception, @keyword.return

    -- Types & Variables
    teal     = "#94E2D5", -- Type, Structure, Class, @type, @structure
    lavender = "#B4BEFE", -- Parameter, Field, Property, @parameter, @field, @property
    indigo   = "#89B4FA", -- StorageClass, Qualifier, @storageclass, @type.qualifier

    -- Metaprogramming & Special
    magenta  = "#D27E99", -- PreProc, Include, Macro, @preproc, @include, @function.macro
    gold     = "#F9E2AF", -- Special, Debug, Tag, @debug, @tag, @text.uri
}
    overrides = {
