:root {{
  /* --- Base16 Raw Definitions --- */
  /* These are mapped from the new semantic theme variables for compatibility. */
  --b00: {{{{custom.myblack}}}};
  --b01: {{{{custom.mysurface}}}};
  --b02: {{{{custom.mysurfacedim}}}};
  --b03: {{{{custom.mysurfaceacc}}}};
  --b04: {{{{custom.mytextdim}}}};
  --b05: {{{{custom.mytextmid}}}};
  --b06: {{{{custom.mytext}}}};        /* Base 06 (using main foreground) */
  --b07: {{{{custom.mytext}}}};         /* Base 07 */
  --b08: {color1};              /* Base 08 */
  --b09: {color2};           /* Base 09 */
  --b0A: {color3};             /* Base 0A (mapped from teal) */
  --b0B: {color4};            /* Base 0B */
  --b0C: {color5};             /* Base 0C */
  --b0D: {color6};             /* Base 0D */
  --b0E: {color7};          /* Base 0E */
  --b0F: {{{{custom.myerror}}}};           /* Base 0F (using orange as fallback) */

  /* --- Core UI (aliased from Base16) --- */
  --background: var(--b00);
  --foreground: var(--b05);

  /* --- Syntax (aliased from Base16) --- */
  --keyword: var(--b0E);
  --string: var(--b0B);
  --number: var(--b09);
  --function_name: var(--b0D);
  --type: var(--b0A);
  --variable: var(--b05);
  --comment: var(--b03);
  --tag: var(--b08);
  --property: var(--b0C);

  /* --- UI States (aliased from Base16) --- */
  --error: var(--b08);
  --warning: var(--b09);
  --success: var(--b0B);
  --info: var(--b0D);
  --accent: {{{{custom.myaccent}}}};

  /* --- UI Surfaces (aliased from Base16) --- */
  --menu_bg: var(--b01);
  --selection_bg: var(--b02);
  --gutter_fg: var(--b04);
}}
